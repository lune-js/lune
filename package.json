{
  "name": "@lune-js/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "lib",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "bun --sequential --filter '*' build",
    "lib": "bun run --cwd lib",
    "clean": "bun --filter '*' clean && rm -rf node_modules",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fresh": "bun clean && bun install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "lefthook install",
    "version": "bun changeset version && bun .changeset/postprocess-changelogs.cjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "packageManager": "bun@1.4.0"
}
