{
  "name": "@lune-js/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "lib",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "bun --sequential --filter '*' build",
    "lib": "bun run --cwd lib",
    "clean": "bun --filter '*' clean && rm -rf node_modules",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fresh": "bun clean && bun install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "lefthook install",
    "changeset": "changeset",
    "version": "changeset version && bun update && node .changeset/postprocess-changelogs.cjs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@happy-dom/global-registrator": "20.13.2",
    "@types/bun": "1.4.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "packageManager": "bun@1.4.0"
}
