{
  "name": "@lune-js/utils",
  "version": "0.3.0",
  "description": "Lower level utilities to build Lune.js",
  "bugs": {
    "url": "https://github.com/lune-js/lune/issues"
  },
  "license": "MIT",
  "author": "Gregory Salinas <ags1130@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lune-js/lune.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist node_modules"
  },
  "devDependencies": {
    "es-toolkit": "1.52.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^14.18.0 || >=16.10.0"
  }
}
